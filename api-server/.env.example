PORT=5001
# Set to the exact trusted reverse-proxy hop count in deployment (usually 1).
# Leave at 0 for direct local development; never set this to `true` blindly.
TRUST_PROXY_HOPS=0
DB_USER=postgres
DB_HOST=127.0.0.1
DB_NAME=cycling_shop
DB_PASSWORD=
DB_PORT=5433
FRONTEND_URL=http://localhost:5173
# Admin account is created explicitly with `npm run admin:create`.
# Google Cloud > OAuth client (Web application). Both values stay on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
# Set NODE_ENV=production behind HTTPS in production (enables Secure cookies).

# Serve the built frontend from dist (automatic in production).
# Run npm run build in the project root before starting the API.
SERVE_FRONTEND=false
